# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=Marketplace API
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=marketplace:

# ─────────────────────────────────────────
# QR SYSTEM
# ─────────────────────────────────────────
QR_SECRET_KEY=your_qr_aes_256_secret_key_32_chars
QR_EXPIRY_MINUTES=10

# ─────────────────────────────────────────
# GOOGLE OAUTH
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────
# APPLE OAUTH
# ─────────────────────────────────────────
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# ─────────────────────────────────────────
# FIREBASE (FCM Push Notifications)
# ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=marketplace-media
CDN_BASE_URL=https://your-cdn.domain.com

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────
# GOOGLE MAPS
# ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────
# SMTP / EMAIL (for OTP & transactional emails)
# ─────────────────────────────────────────
# Option A — Standard SMTP (any host, e.g. Brevo, Mailgun, Zoho):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Option B — Named service shortcut (gmail, yahoo, etc.):
# SMTP_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password

# Sender address shown in emails:
EMAIL_FROM="Aliwayz" <noreply@aliwayz.com>